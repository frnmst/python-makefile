ARCH := $$(uname --kernel-name --kernel-release --kernel-version --machine)
PYTHON_VERSION := $$(python --version)
PIP_VERSION_MAJOR := $$(pip --version | awk '{print $$2}' | cut --delimiter='.' --fields=1)

# See
# https://docs.python.org/3/library/venv.html#how-venvs-work
VENV_NEW := python3 -m venv .venv
VENV_ACTIVATE := . .venv/bin/activate
VENV_DEACTIVATE := deactivate
LOCK_DEV_FILENAME := $$(uname -s | tr '[:upper:]' '[:lower:]')-py$$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')-requirements-dev.lock
LOCK_FILENAME := $$(uname -s | tr '[:upper:]' '[:lower:]')-py$$(python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')-requirements.lock

# Version 26 instroduced `--uploaded-prior-to`.
ifeq ($(shell test $(PIP_VERSION_MAJOR) -ge 26 && echo true),true)
	PIP_ARGS := --pip-args="--uploaded-prior-to=$$(date -d '-3days' -Idate)"
else
	PIP_ARGS :=
endif

include .project.mk

default: install-dev

# Build the docs if the directory exists.
doc::
ifeq ($(OVERRIDE_DOC),)
ifeq ($(wildcard docs/.),)
	@echo 'error: no docs available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& $(MAKE) -C docs html; \
		$(VENV_DEACTIVATE)
endif
endif

# pip-audit and pip-tools must always be in the dev dependencies.
# Install anyway even if vulnerabilities are found: just tell it to the user.
install-dev:: uninstall-dev
ifeq ($(OVERRIDE_INSTALL_DEV),)
	$(VENV_NEW) \
		&& $(VENV_ACTIVATE) \
		&& pip install \
			--require-hashes \
			--require-venv \
			--requirement=$(LOCK_DEV_FILENAME) \
		&& pip-audit \
			--strict \
			--requirement $(LOCK_DEV_FILENAME); \
		pip install \
			--require-venv \
			--no-deps \
			--editable .; \
		$(VENV_DEACTIVATE)
	$(VENV_ACTIVATE) \
		&& pre-commit install; \
		$(VENV_DEACTIVATE)
	$(VENV_ACTIVATE) \
		&& pre-commit install --hook-type commit-msg; \
		$(VENV_DEACTIVATE)
endif

# Always start with a fresh environment when regenating lock files.
regenerate-lock:: uninstall-dev
ifeq ($(OVERRIDE_REGENERATE_LOCK),)
	$(VENV_NEW) \
		&& $(VENV_ACTIVATE) \
		&& pip install -e .[dev] \
		&& pip-compile \
			--generate-hashes \
			--strip-extras \
			--allow-unsafe pyproject.toml \
		    --output-file=$(LOCK_FILENAME) \
			$(PIP_ARGS) \
		&& pip-audit \
			--strict \
			--requirement $(LOCK_FILENAME); \
		$(VENV_DEACTIVATE)
endif

regenerate-dev-lock:: uninstall-dev
ifeq ($(OVERRIDE_REGENERATE_DEV_LOCK),)
	$(VENV_NEW) \
		&& $(VENV_ACTIVATE) \
		&& pip install -e .[dev] \
		&& pip-compile \
			--extra=dev \
			--generate-hashes \
			--strip-extras \
			--allow-unsafe pyproject.toml \
		    --output-file=$(LOCK_DEV_FILENAME) \
			$(PIP_ARGS) \
		&& pip-audit \
			--strict \
			--requirement $(LOCK_DEV_FILENAME); \
		$(VENV_DEACTIVATE)
endif


uninstall-dev::
ifeq ($(OVERRIDE_UNINSTALL_DEV),)
	rm -rf .venv
endif

pre-commit-update:: install-dev
ifeq ($(OVERRIDE_UPDATE),)
	$(VENV_ACTIVATE) \
		&& pre-commit autoupdate \
			--repo https://github.com/pre-commit/pre-commit-hooks \
			--repo https://github.com/PyCQA/bandit \
			--repo https://github.com/pycqa/isort \
			--repo https://github.com/frnmst/md-toc \
			--repo https://github.com/ljnsn/cz-conventional-gitmoji \
			--repo https://github.com/jorisroovers/gitlint; \
		$(VENV_DEACTIVATE)
endif

test:
ifeq ($(wildcard ${PYTHON_MODULE_NAME}/tests/tests.py),)
	@echo 'error: no tests available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& tox run-parallel; \
		$(VENV_DEACTIVATE)
endif

test-single:
ifeq ($(wildcard ${PYTHON_MODULE_NAME}/tests/tests.py),)
	@echo 'error: no tests available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& python -m unittest discover --failfast --locals --verbose; \
		$(VENV_DEACTIVATE)
endif

test-coverage:
ifeq ($(wildcard ${PYTHON_MODULE_NAME}/tests/tests.py),)
	@echo 'error: no tests available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& coverage run --branch -m unittest discover --failfast --locals --verbose \
		&& coverage html; \
		$(VENV_DEACTIVATE)
endif

fuzzer:
ifeq ($(wildcard ${PYTHON_MODULE_NAME}/tests/fuzzer.py),)
	@echo 'error: no fuzzer available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& tox run -e fuzzer; \
		$(VENV_DEACTIVATE)
endif

pre-commit:
	$(VENV_ACTIVATE) \
		&& pre-commit run --all; \
		$(VENV_DEACTIVATE)

demo:
ifeq ($(wildcard asciinema/.),)
	@echo 'error: no demo available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& asciinema/$(PYTHON_MODULE_NAME)_asciinema_$$(git describe --tags $$(git rev-list --tags --max-count=1) | tr '.' '_')_demo.sh; \
		$(VENV_DEACTIVATE)
endif

dist:
	# Create a reproducible archive at least on the wheel.
	# See
	# https://bugs.python.org/issue31526
	# https://bugs.python.org/issue38727
	# https://github.com/pypa/setuptools/issues/1468
	# https://github.com/pypa/setuptools/issues/2133
	# https://reproducible-builds.org/docs/source-date-epoch/
	docker build \
		--no-cache \
		-f Dockerfile.python3.13_hatchling.build \
		--output ./dist .

upload:
	$(VENV_ACTIVATE) \
		&& twine upload --repository $(PROJECT_NAME) dist/*; \
		$(VENV_DEACTIVATE)

clean::
ifeq ($(OVERRIDE_CLEAN),)
	rm -rf build dist *.egg-info tests/benchmark-results
	# Remove all markdown files except the readmes.
	find -regex "\(.*/crash-[a-f0-9]+\|.*\.[mM][dD]\)$$" \
		! -name 'README.md' \
		! -name 'CONTRIBUTING.md' \
		! -name 'SECURITY.md' \
		! -name 'CHANGELOG.md' \
		! -name 'API.md' \
		! -path './.venv/*' \
		! -path './.git/*' -type f -exec rm -f {} +
ifneq ($(wildcard docs/.),)
	$(VENV_ACTIVATE) \
		&& $(MAKE) -C docs clean; \
		$(VENV_DEACTIVATE)
endif
endif

# This serves both as benchmark and as fuzzer.
benchmark:
ifeq ($(wildcard $(PYTHON_MODULE_NAME)/tests/benchmark.py),)
	@echo 'error: no benchmark available'
	@exit 1
else
	$(VENV_ACTIVATE) \
		&& python3 -m $(PYTHON_MODULE_NAME).tests.benchmark; \
		$(VENV_DEACTIVATE)
endif

.PHONY: default doc install-dev uninstall-dev update test clean demo benchmark pre-commit regenerate-lock regenerate-dev-lock dist
