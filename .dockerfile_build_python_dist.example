FROM python:3.11.8-slim-bookworm@sha256:90f8795536170fd08236d2ceb74fe7065dbf74f738d8b84bfbf263656654dc9b

# Create a reproducible archive at least on the wheel.
# See
# https://bugs.python.org/issue31526
# https://bugs.python.org/issue38727
# https://github.com/pypa/setuptools/issues/1468
# https://github.com/pypa/setuptools/issues/2133
# https://reproducible-builds.org/docs/source-date-epoch/

WORKDIR /app

# 1. cleanup
# 2. create the distributions
# 3. check
# 4. generate checksums
CMD rm -rf dist/* \
    && pip3 install -r requirements-freeze.txt \
    && SOURCE_DATE_EPOCH=0 python -m build \
    && twine check --strict dist/* \
    && export WHEEL_NAME="$(basename $(find dist/. -name *.whl))" \
    && sha256sum dist/"${WHEEL_NAME}" > dist/"${WHEEL_NAME}".SHA256SUM.txt \
    && md5sum dist/"${WHEEL_NAME}" > dist/"${WHEEL_NAME}".MD5SUM.txt
